# Z.ai GLM API key — required for live agent run, deep research, and web reader.
# When absent the demo runs in deterministic synthetic mode (degraded mode) and
# returns pre-built realistic agent traces. Either path produces identical UI.
GLM_API_KEY=

# Optional overrides:
# GLM_MODEL=glm-5.1                   # default model id
# GLM_USE_STANDARD_ENDPOINT=false     # default false; coding endpoint enables web_search/reader/zread quota
